{
  "manifest_version": 3,
  "name": "WhatsTheirPay: pay estimates on LinkedIn",
  "short_name": "WhatsTheirPay",
  "version": "2.0.0",
  "description": "Transparent pay estimates for LinkedIn profiles and job posts: base, bonus and equity, with the math shown.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WhatsTheirPay",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*", "http://localhost:8787/*", "https://api.whatstheirpay.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/card.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
