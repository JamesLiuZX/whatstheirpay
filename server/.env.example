# Copy to .env and fill in. Every value is optional in development.
PORT=8787
# Public URL of this server (used for redirects, emails, Stripe return URLs)
PUBLIC_URL=http://localhost:8787
# production | development
NODE_ENV=development
# Signs IP hashes. Required in production; generated and stored in the DB otherwise.
APP_SECRET=
# Set to 1 behind a reverse proxy / load balancer so X-Forwarded-For is trusted
TRUST_PROXY=0
# Extra origins allowed to call the API from a browser (comma separated)
WEB_ORIGINS=
# Comma-separated Chrome extension IDs allowed in production (any ID is allowed in development)
EXTENSION_IDS=
# SQLite file location
DATABASE_PATH=./data/wtp.db

# --- Email (sign-in codes). Without it, codes are printed to the console in development.
RESEND_API_KEY=
EMAIL_FROM=WhatsTheirPay <login@whatstheirpay.com>

# --- Billing. Without STRIPE_SECRET_KEY the server uses a built-in test checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PRO_PASS=

# --- Profile enrichment for pasted URLs (People Data Labs). Without it, the web try asks for title/company/city.
PDL_API_KEY=
